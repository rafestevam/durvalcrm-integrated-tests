# Configuração de Ambiente - DurvalCRM Integrated Tests

# URL base da aplicação a ser testada
# Desenvolvimento WildFly: http://localhost:9080/crm
# Desenvolvimento Vite: http://localhost:3000
# Staging: https://localhost:9443
# Produção: https://crm.durvalcrm.org
BASE_URL=http://localhost:9080/crm

# Credenciais de teste (opcional - pode ser configurado nos testes)
TEST_USERNAME=tesouraria
TEST_PASSWORD=cairbar@2025

# Timeout global (ms)
TEST_TIMEOUT=30000

# Habilitar modo headless (true para CI, false para debug local)
HEADLESS=false

# Configuração de Keycloak (se necessário)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=durvalcrm
KEYCLOAK_CLIENT_ID=durvalcrm-frontend
