{
  "name": "durvalcrm-integrated-testing",
  "version": "1.0.0",
  "description": "DurvalCRM Integrated Business Tests with Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:sprint01": "playwright test tests/sprint01",
    "test:us060": "playwright test tests/sprint01/us060-contas-bancarias.spec.ts",
    "test:us061": "playwright test tests/sprint01/us061-registro-recebimentos.spec.ts",
    "test:crud-associados": "playwright test tests/crud/crud-associados.spec.ts",
    "test:crud-associados:headed": "playwright test tests/crud/crud-associados.spec.ts --headed",
    "test:crud-associados:debug": "playwright test tests/crud/crud-associados.spec.ts --debug",
    "test:debug-login": "playwright test tests/debug-login.spec.ts --headed",
    "test:debug-login-ui": "playwright test tests/debug-login.spec.ts --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "keywords": [
    "playwright",
    "e2e",
    "business-tests",
    "durvalcrm"
  ],
  "author": "DurvalCRM Team",
